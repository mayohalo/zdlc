# /etc/zdlc/zdlc.env on the server (install.sh creates it from this; it is not in git).
# A Zakura testnet JSON-RPC endpoint, reachable from this server only (a private network).
ZDLC_RPC=http://PRIVATE-NODE-ADDRESS:PORT/
ROOM_LABEL=testnet
# What one escrow locks, in ZEC. Both parties are the server's own nodes, so the amount
# stays in the demo; each room burns only fees (about 0.0003-0.0005 ZEC).
ROOM_AMOUNT=0.001
# Rooms open at once (each holds a demo-wallet coin until it settles).
ROOM_MAX=20
# Extra zdlc-room flags, e.g. --explorer 'https://<a testnet explorer>/tx/{txid}'
ROOM_ARGS=
