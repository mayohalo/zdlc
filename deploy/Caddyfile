# HTTPS for the site; Caddy gets the certificate. DOMAIN is filled in by install.sh.
# The landing page is at /; the escrow room at /escrow and the hedge desk at /hedge.
# /room and /desk are their old addresses: the server redirects them.
DOMAIN {
	encode gzip
	@app path /escrow /escrow/* /hedge /hedge/* /room /room/* /desk
	handle @app {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /opt/zdlc/site
		file_server
	}
}
