{
  "openapi": "3.1.0",
  "info": {
    "title": "zdlc-node",
    "version": "0.1.0",
    "description": "Discreet Log Contracts on Zcash. Offer and accept contracts from templates, fund them from a treasury or a shielded deposit link, and follow them to settlement through events. Every route except this spec needs `Authorization: Bearer <token>`; the token is in the node's token file. Amounts are zatoshis (1 ZEC = 100,000,000)."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7950"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/info": {
      "get": {
        "operationId": "info",
        "summary": "This node: its identity (what counterparties offer to), network, tip, treasury address and oracles",
        "responses": {
          "200": {
            "description": "Node info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/balance": {
      "get": {
        "operationId": "balance",
        "summary": "Treasury, shielded balance and collateral locked in live contracts",
        "responses": {
          "200": {
            "description": "Balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/contracts": {
      "get": {
        "operationId": "listContracts",
        "summary": "Every contract, newest first",
        "responses": {
          "200": {
            "description": "Contracts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Contract"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "offer",
        "summary": "Offer a contract to a counterparty, from a template",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new contract's id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/contracts/{id}": {
      "get": {
        "operationId": "getContract",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "The contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contract"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/contracts/{id}/accept": {
      "post": {
        "operationId": "accept",
        "summary": "Accept an incoming offer. With deposit funding the node emits awaitingDeposit with a ZIP 321 link any wallet can pay",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "funding"
                ],
                "properties": {
                  "funding": {
                    "$ref": "#/components/schemas/Funding"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/contracts/{id}/decline": {
      "post": {
        "operationId": "decline",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Declined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/contracts/{id}/hold": {
      "post": {
        "operationId": "hold",
        "summary": "Hold or release a contract: while held, this node drops its messages and takes no step on it, as if offline for it",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "held"
                ],
                "properties": {
                  "held": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Held or released",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "held": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/contracts/{id}/attempt": {
      "post": {
        "operationId": "attempt",
        "summary": "Try to spend a funded contract against its terms and report what the chain said: refund (refused before the refund height) or forge (this side's best payout with made-up oracle signatures, always refused)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "refund",
                      "forge"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What the chain said",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string"
                    },
                    "txid": {
                      "type": "string"
                    },
                    "accepted": {
                      "type": "boolean"
                    },
                    "tip": {
                      "type": "integer"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/contracts/{id}/qr.svg": {
      "get": {
        "operationId": "depositQr",
        "summary": "The deposit link as a QR code",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "SVG",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "events",
        "summary": "Events after a sequence number; long-polls up to `wait` seconds (max 60)",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "wait",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events",
                    "next"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "next": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/withdraw": {
      "post": {
        "operationId": "withdraw",
        "summary": "Send the whole shielded balance to a unified address (its Ironwood receiver)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "to"
                ],
                "properties": {
                  "to": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transactions sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "txids"
                  ],
                  "properties": {
                    "txids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "spec",
        "security": [],
        "responses": {
          "200": {
            "description": "This document"
          }
        }
      }
    },
    "/v1/recover": {
      "post": {
        "operationId": "recover",
        "summary": "Seed-only recovery: find this wallet's recovery records and broadcast every refund that is due",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "integer",
                    "description": "Height to scan from"
                  },
                  "gap": {
                    "type": "integer",
                    "default": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Records found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "records"
                  ],
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer"
                          },
                          "fundingTxid": {
                            "type": "string"
                          },
                          "refundHeight": {
                            "type": "integer"
                          },
                          "collateral": {
                            "type": "integer"
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Id": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "Funding": {
        "type": "string",
        "enum": [
          "treasury",
          "deposit"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "offerer",
          "accepter"
        ]
      },
      "State": {
        "type": "string",
        "enum": [
          "offered",
          "incoming",
          "awaiting_deposit",
          "refreshing",
          "accepted",
          "signed",
          "funded",
          "closing",
          "settled",
          "declined",
          "failed"
        ]
      },
      "Info": {
        "type": "object",
        "required": [
          "identity",
          "network",
          "tip",
          "treasury",
          "oracles"
        ],
        "properties": {
          "identity": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "tip": {
            "type": "integer"
          },
          "treasury": {
            "type": "string"
          },
          "oracles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "pubkey": {
                  "type": "string"
                }
              }
            }
          },
          "transport": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          },
          "chain": {
            "type": "string"
          }
        }
      },
      "Balance": {
        "type": "object",
        "required": [
          "treasuryZat",
          "shieldedZat",
          "shieldedNotes",
          "inContractsZat"
        ],
        "properties": {
          "treasuryZat": {
            "type": "integer"
          },
          "shieldedZat": {
            "type": "integer"
          },
          "shieldedNotes": {
            "type": "integer"
          },
          "inContractsZat": {
            "type": "integer"
          }
        }
      },
      "Payee": {
        "type": "object",
        "required": [
          "label",
          "address",
          "bps"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "description": "Transparent address"
          },
          "shielded": {
            "type": "string",
            "description": "Unified address paid on a cooperative close"
          },
          "bps": {
            "type": "integer"
          }
        }
      },
      "Template": {
        "oneOf": [
          {
            "type": "object",
            "title": "StablePayment",
            "description": "The offerer is owed usdCents in ZEC at the price minute; the accepter hedges with the same collateral and earns the premium",
            "required": [
              "template",
              "usd_cents",
              "collateral_zat",
              "maturity_blocks",
              "refund_blocks"
            ],
            "properties": {
              "template": {
                "const": "stable_payment"
              },
              "usd_cents": {
                "type": "integer"
              },
              "collateral_zat": {
                "type": "integer"
              },
              "premium_zat": {
                "type": "integer"
              },
              "maturity_blocks": {
                "type": "integer"
              },
              "refund_blocks": {
                "type": "integer"
              },
              "price_minute": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "Hedge",
            "description": "The offerer protects amount_zat of ZEC at price_cents (USD per ZEC); the accepter hedges and earns the premium",
            "required": [
              "template",
              "amount_zat",
              "price_cents",
              "maturity_blocks",
              "refund_blocks"
            ],
            "properties": {
              "template": {
                "const": "hedge"
              },
              "amount_zat": {
                "type": "integer"
              },
              "price_cents": {
                "type": "integer"
              },
              "premium_zat": {
                "type": "integer"
              },
              "maturity_blocks": {
                "type": "integer"
              },
              "refund_blocks": {
                "type": "integer"
              },
              "price_minute": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "Payroll",
            "description": "A dollar salary paid in ZEC per period; the offerer (employee) is owed usd_cents each period; the next period is offered when one settles and accepted the same way",
            "required": [
              "template",
              "usd_cents",
              "collateral_zat",
              "periods",
              "period_blocks",
              "refund_margin_blocks"
            ],
            "properties": {
              "template": {
                "const": "payroll"
              },
              "usd_cents": {
                "type": "integer"
              },
              "collateral_zat": {
                "type": "integer"
              },
              "premium_zat": {
                "type": "integer"
              },
              "periods": {
                "type": "integer"
              },
              "period_blocks": {
                "type": "integer"
              },
              "refund_margin_blocks": {
                "type": "integer"
              },
              "period": {
                "type": "integer",
                "default": 1
              },
              "series_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "price_minute": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "PayOnPayment",
            "description": "The accepter (borrower) locks collateral_zat; it comes back if amount_zat reaches the offerer's repay_to within by_blocks, else the offerer takes it. The node fills repay_to and its viewing key",
            "required": [
              "template",
              "amount_zat",
              "collateral_zat",
              "by_blocks",
              "refund_blocks"
            ],
            "properties": {
              "template": {
                "const": "pay_on_payment"
              },
              "amount_zat": {
                "type": "integer"
              },
              "collateral_zat": {
                "type": "integer"
              },
              "by_blocks": {
                "type": "integer"
              },
              "refund_blocks": {
                "type": "integer"
              },
              "repay_to": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ivk": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "from_height": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "Escrow",
            "description": "The offerer (contractor) is paid amount_zat on \"delivered\"; the accepter (client) funds it alone",
            "required": [
              "template",
              "amount_zat",
              "question",
              "maturity_blocks",
              "refund_blocks"
            ],
            "properties": {
              "template": {
                "const": "escrow"
              },
              "amount_zat": {
                "type": "integer"
              },
              "question": {
                "type": "string"
              },
              "payees": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Payee"
                }
              },
              "maturity_blocks": {
                "type": "integer"
              },
              "refund_blocks": {
                "type": "integer"
              }
            }
          },
          {
            "type": "object",
            "title": "Bet",
            "description": "Both stake stake_zat; the winner takes both",
            "required": [
              "template",
              "question",
              "outcomes",
              "offerer_wins",
              "stake_zat",
              "maturity_blocks",
              "refund_blocks"
            ],
            "properties": {
              "template": {
                "const": "bet"
              },
              "question": {
                "type": "string"
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "offerer_wins": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stake_zat": {
                "type": "integer"
              },
              "maturity_blocks": {
                "type": "integer"
              },
              "refund_blocks": {
                "type": "integer"
              }
            }
          }
        ],
        "discriminator": {
          "propertyName": "template"
        }
      },
      "OfferRequest": {
        "type": "object",
        "required": [
          "counterparty",
          "template"
        ],
        "properties": {
          "counterparty": {
            "type": "string",
            "description": "The counterparty's identity (its /v1/info identity)"
          },
          "template": {
            "$ref": "#/components/schemas/Template"
          }
        }
      },
      "Settlement": {
        "type": "object",
        "required": [
          "how"
        ],
        "properties": {
          "how": {
            "type": "string",
            "enum": [
              "close",
              "cet",
              "refund",
              "counterparty"
            ]
          },
          "txid": {
            "type": [
              "string",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Contract": {
        "type": "object",
        "required": [
          "id",
          "role",
          "state",
          "counterparty",
          "template",
          "summary",
          "eventId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "counterparty": {
            "type": "string"
          },
          "template": {
            "$ref": "#/components/schemas/Template"
          },
          "summary": {
            "type": "object"
          },
          "eventId": {
            "type": "string"
          },
          "funding": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Funding"
              },
              {
                "type": "null"
              }
            ]
          },
          "deposit": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string"
                  },
                  "zat": {
                    "type": "integer"
                  },
                  "from": {
                    "type": "integer"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "fundingTxid": {
            "type": [
              "string",
              "null"
            ]
          },
          "maturity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "refundHeight": {
            "type": [
              "integer",
              "null"
            ]
          },
          "attested": {
            "type": [
              "string",
              "null"
            ]
          },
          "settlement": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Settlement"
              },
